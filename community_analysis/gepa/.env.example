# ── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Model Routing ──────────────────────────────────
AGENT_MODEL=gpt-4o-mini
MODERATOR_MODEL=gpt-4o

# ── Auth ───────────────────────────────────────────
API_KEY=your-secret-api-key

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_RPM=10

# ── Cache ──────────────────────────────────────────
CACHE_TTL_SECONDS=900

# ── LLM Retry ─────────────────────────────────────
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.3
